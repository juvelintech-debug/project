# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Origin allowed by CORS. In dev the Vite server proxies /api, so this is only
# needed if you call the API directly from another origin.
CLIENT_ORIGIN=http://localhost:5173

# ── Authentication ────────────────────────────────────────────────────────────
# REQUIRED in production. If left empty in development a temporary secret is
# generated and written to .env so restarts do not invalidate logged-in sessions.
JWT_SECRET=
JWT_EXPIRES_IN=2h

# ── Database (MySQL) ──────────────────────────────────────────────────────────
# Create the schema first:  npm run db:create  (creates the database itself),
# then  npm run db:migrate  and  npm run db:seed
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=placement_db
# Pool size: a college placement cell is tens of concurrent users, not thousands.
DB_POOL_SIZE=10
# Offline verification only. DB_CLIENT=sqlite runs the same schema.sql through a
# translation adapter so `npm test` and the migrate/seed CLIs work on a machine
# with no MySQL server (this is how the sandbox checks the database). Production
# must stay on mysql — SQLite has no separate server, no real ENUM enforcement and
# is not a supported deployment target.
# SQLITE_FILE=./.placement-sandbox.sqlite   # only read when DB_CLIENT=sqlite

# ── File uploads (resumes, company evidence) ──────────────────────────────────
# This directory is intentionally OUTSIDE the served web root.
UPLOAD_DIR=./uploads
MAX_RESUME_MB=2

# ── AI service (server-side only — never sent to the browser) ─────────────────
# Works fully offline: with no key the app degrades to deterministic analysis and
# every AI screen shows an honest "AI unavailable" state.
AI_PROVIDER=gemini
AI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=25000
AI_DAILY_QUOTA_PER_STUDENT=25
