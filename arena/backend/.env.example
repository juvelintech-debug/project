# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Origin allowed by CORS. In dev the Vite server proxies /api, so this is only
# needed if you call the API directly from another origin.
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 ONLY behind one controlled reverse proxy; leave 0 for direct/local use.
TRUST_PROXY_HOPS=0
# Turn on only for a database you populated with the clearly labelled demo seed.
DEMO_MODE=false

# ── Authentication ────────────────────────────────────────────────────────────
# REQUIRED in production. If left empty in development a temporary secret is
# generated and written to .env so restarts do not invalidate logged-in sessions.
JWT_SECRET=
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=10
LOGIN_MAX_ATTEMPTS=6
LOGIN_WINDOW_MINUTES=15
LOGIN_PER_IP_MAX_ATTEMPTS=60
REGISTER_PER_HOUR_PER_IP=12
# Existing Phase 2 DB: run npm run db:upgrade:auth (no rows are deleted).

# ── First administrator (controlled CLI only; never public registration) ─────
# Run npm run admin:bootstrap on an unseeded DB, then unset/remove the password.
# Repeated runs never overwrite an existing Admin or add another.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_PASSWORD=

# ── Database (MySQL) ──────────────────────────────────────────────────────────
# Create the schema first:  npm run db:create  (creates the database itself),
# then npm run db:migrate and npm run admin:bootstrap for real, unseeded use.
# db:seed is a DESTRUCTIVE demo reset only; it deletes all target rows.
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=placement_db
# Pool size: a college placement cell is tens of concurrent users, not thousands.
DB_POOL_SIZE=10
# Offline verification only. DB_CLIENT=sqlite runs the same schema.sql through a
# translation adapter so `npm test` and the migrate/seed CLIs work on a machine
# with no MySQL server (this is how the sandbox checks the database). Production
# must stay on mysql — SQLite has no separate server, no real ENUM enforcement and
# is not a supported deployment target.
# SQLITE_FILE=./.placement-sandbox.sqlite   # only read when DB_CLIENT=sqlite

# ── File uploads (resumes, company evidence) ──────────────────────────────────
# This directory is intentionally OUTSIDE the served web root.
UPLOAD_DIR=./uploads
MAX_RESUME_MB=2

# ── AI service (server-side only — never sent to the browser) ─────────────────
# Reserved for future AI phases; Phase 3 auth works with no key.
# Configuring these does not implement AI endpoints or invented AI feedback.
AI_PROVIDER=gemini
AI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=25000
AI_DAILY_QUOTA_PER_STUDENT=25
